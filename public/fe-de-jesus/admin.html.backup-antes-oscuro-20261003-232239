<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fe de Jesús — Instructor</title>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Arial, sans-serif; background: #f0f4f8; color: #1a202c; }
  header { background: #1a3a6b; color: white; padding: 18px 24px; }
  header h1 { margin: 0; font-size: 24px; }
  header p { margin: 5px 0 0; opacity: 0.85; font-size: 14px; }
  main { max-width: 1200px; margin: 20px auto; padding: 0 18px; }
  .panel { background: white; border-radius: 14px; padding: 22px; box-shadow: 0 3px 12px rgba(0,0,0,0.08); margin-bottom: 18px; }
  label { display: block; font-weight: bold; margin-bottom: 6px; color: #1a3a6b; }
  select { width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 8px; font-size: 16px; background: white; }
  .preguntas-lista { max-height: 280px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 10px; margin-top: 12px; }
  .pregunta-item { padding: 12px 15px; border-bottom: 1px solid #edf2f7; cursor: pointer; display: flex; gap: 12px; align-items: flex-start; }
  .pregunta-item:last-child { border-bottom: none; }
  .pregunta-item:hover { background: #ebf4ff; }
  .pregunta-item.selected { background: #bee3f8; border-left: 4px solid #1a3a6b; }
  .pregunta-num { font-weight: bold; color: #1a3a6b; min-width: 28px; }
  .preview { background: #f7fafc; border: 2px solid #cbd5e0; border-radius: 12px; padding: 22px; margin-top: 18px; }
  .preview-header { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #718096; margin-bottom: 12px; }
  .preview-titulo { font-size: 14px; color: #1a3a6b; font-weight: bold; margin-bottom: 4px; }
  .preview-pregunta { font-size: 22px; font-weight: bold; line-height: 1.4; margin: 15px 0; }
  .preview-referencia { font-size: 17px; color: #1a3a6b; font-weight: bold; margin-bottom: 18px; }
  .preview-opciones { list-style: none; padding: 0; margin: 0; }
  .preview-opciones li { padding: 10px 14px; border-radius: 8px; margin-bottom: 6px; background: white; border: 1px solid #e2e8f0; font-size: 16px; }
  .preview-opciones li.correcta { background: #c6f6d5; border-color: #2f855a; font-weight: bold; }
  .preview-opciones li.correcta::before { content: "✓ "; color: #2f855a; font-weight: bold; }
  .acciones { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
  button { border: none; border-radius: 9px; padding: 14px 22px; font-size: 16px; font-weight: bold; cursor: pointer; }
  button:disabled { background: #cbd5e0 !important; color: #718096 !important; cursor: not-allowed; }
  #btnMostrar { background: #1a3a6b; color: white; flex: 2; }
  #btnRevelar { background: #d4a017; color: white; flex: 1; }
  #btnBiblia { background: #2c5282; color: white; flex: 1; }
  #btnAnterior, #btnSiguiente { background: #e2e8f0; color: #1a3a6b; }
  .estado { margin-top: 15px; padding: 10px 14px; border-radius: 8px; background: #edf2f7; font-size: 14px; }
  .estado.connected { background: #c6f6d5; color: #22543d; }
  .estado.disconnected { background: #fed7d7; color: #742a2a; }
  .badge-tipo { display: inline-block; padding: 3px 9px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase; background: #bee3f8; color: #1a3a6b; margin-left: 8px; }
  @media (max-width: 700px) { .preview-pregunta { font-size: 18px; } }
</style>
</head>
<body>
<header>
  <h1>✝️ Fe de Jesús — Panel del Instructor</h1>
  <p>Estudios bíblicos sincronizados</p>
</header>
<main>
  <section class="panel">
    <label for="estudioSelect">Estudio</label>
    <select id="estudioSelect"><option value="">Cargando estudios...</option></select>
    <div style="margin-top:18px;">
      <label>Preguntas</label>
      <div class="preguntas-lista" id="preguntasLista">
        <div style="padding:20px;color:#718096;">Seleccione un estudio.</div>
      </div>
    </div>
  </section>
  <section class="panel">
    <div class="preview" id="preview">
      <div class="preview-header">Vista previa</div>
      <div style="color:#718096;">Seleccione una pregunta para previsualizarla.</div>
    </div>
    <div class="acciones">
      <button id="btnMostrar" disabled>📱 MOSTRAR EN CELULARES</button>
      <button id="btnRevelar" disabled>✓ REVELAR RESPUESTA</button>
      <button id="btnBiblia" disabled>📖 ABRIR EN BIBLIA</button>
    </div>
    <div class="acciones">
      <button id="btnAnterior" disabled>◀ Anterior</button>
      <button id="btnSiguiente" disabled>Siguiente ▶</button>
    </div>
    <div class="estado" id="estado">
      Estado WebSocket: <span id="wsStatus">Conectando...</span>
      | Celulares conectados: <span id="connectedCount">0</span>
    </div>
  </section>
</main>
<script>
  const estudioSelect = document.getElementById("estudioSelect");
  const preguntasLista = document.getElementById("preguntasLista");
  const preview = document.getElementById("preview");
  const btnMostrar = document.getElementById("btnMostrar");
  const btnRevelar = document.getElementById("btnRevelar");
  const btnBiblia = document.getElementById("btnBiblia");
  const btnAnterior = document.getElementById("btnAnterior");
  const btnSiguiente = document.getElementById("btnSiguiente");
  const wsStatus = document.getElementById("wsStatus");
  const connectedCount = document.getElementById("connectedCount");
  const estado = document.getElementById("estado");

  let ws = null, estudioActual = null, preguntaActual = null, respuestaRevelada = false;

  function connectWebSocket() {
    const protocol = location.protocol === "https:" ? "wss:" : "ws:";
    const wsBase = location.pathname.startsWith("/biblia") ? "/biblia" : "";
    ws = new WebSocket(`${protocol}//${location.host}${wsBase}`);
    ws.addEventListener("open", () => {
      wsStatus.textContent = "Conectado";
      estado.classList.add("connected");
      estado.classList.remove("disconnected");
    });
    ws.addEventListener("close", () => {
      wsStatus.textContent = "Desconectado";
      estado.classList.remove("connected");
      estado.classList.add("disconnected");
      setTimeout(connectWebSocket, 2000);
    });
    ws.addEventListener("error", () => { wsStatus.textContent = "Error"; });
    ws.addEventListener("message", (event) => {
      try {
        const data = JSON.parse(event.data);
        if (data.type === "connected") connectedCount.textContent = data.count;
      } catch (e) { console.error(e); }
    });
  }

  async function cargarEstudios() {
    try {
      const res = await fetch("../api/fe-de-jesus/estudios");
      const estudios = await res.json();
      if (estudios.length === 0) {
        estudioSelect.innerHTML = '<option value="">No hay estudios cargados</option>';
        return;
      }
      estudioSelect.innerHTML = '<option value="">Seleccione un estudio</option>';
      estudios.forEach(e => {
        const opt = document.createElement("option");
        opt.value = e.id;
        opt.textContent = `Estudio ${String(e.id).padStart(2, "0")} — ${e.titulo}`;
        estudioSelect.appendChild(opt);
      });
    } catch (err) {
      estudioSelect.innerHTML = '<option value="">Error al cargar</option>';
    }
  }

  async function cargarEstudio(id) {
    if (!id) {
      preguntasLista.innerHTML = '<div style="padding:20px;color:#718096;">Seleccione un estudio.</div>';
      return;
    }
    const res = await fetch(`../api/fe-de-jesus/estudio/${id}`);
    estudioActual = await res.json();
    preguntaActual = null;
    respuestaRevelada = false;
    renderPreguntasLista();
    limpiarPreview();
    actualizarBotones();
  }

  function renderPreguntasLista() {
    preguntasLista.innerHTML = "";
    if (!estudioActual || !estudioActual.preguntas) return;
    estudioActual.preguntas.forEach(p => {
      const div = document.createElement("div");
      div.className = "pregunta-item";
      if (preguntaActual && p.n === preguntaActual.n) div.classList.add("selected");
      div.innerHTML = `<div class="pregunta-num">${p.n}</div><div>${escapeHtml(p.pregunta)}${p.opciones && p.opciones.length > 0 ? '<span class="badge-tipo">opción múltiple</span>' : ''}</div>`;
      div.addEventListener("click", () => seleccionarPregunta(p));
      preguntasLista.appendChild(div);
    });
  }

  function seleccionarPregunta(p) {
    preguntaActual = p;
    respuestaRevelada = false;
    renderPreguntasLista();
    renderPreview();
    actualizarBotones();
  }

  function renderPreview() {
    if (!preguntaActual) { limpiarPreview(); return; }
    const total = estudioActual.preguntas.length;
    let opcionesHTML = "";
    if (preguntaActual.opciones && preguntaActual.opciones.length > 0) {
      opcionesHTML = '<ul class="preview-opciones">' +
        preguntaActual.opciones.map((op, i) => {
          const esCorrecta = respuestaRevelada && i === preguntaActual.correcta;
          return `<li class="${esCorrecta ? "correcta" : ""}">${escapeHtml(op)}</li>`;
        }).join("") + "</ul>";
    } else {
      opcionesHTML = '<div style="color:#718096;font-style:italic;padding:10px 0;">Pregunta abierta (respuesta según el texto bíblico)</div>';
    }
    preview.innerHTML = `
      <div class="preview-header">Pregunta ${preguntaActual.n} de ${total}</div>
      <div class="preview-titulo">${escapeHtml(estudioActual.titulo)}</div>
      <div class="preview-pregunta">${escapeHtml(preguntaActual.pregunta)}</div>
      <div class="preview-referencia">📖 ${escapeHtml(preguntaActual.referencia)}</div>
      ${opcionesHTML}
    `;
  }

  function limpiarPreview() {
    preview.innerHTML = '<div class="preview-header">Vista previa</div><div style="color:#718096;">Seleccione una pregunta para previsualizarla.</div>';
  }

  function actualizarBotones() {
    const hayPregunta = !!preguntaActual;
    const hayOpciones = hayPregunta && preguntaActual.opciones && preguntaActual.opciones.length > 0;
    btnMostrar.disabled = !hayPregunta;
    btnRevelar.disabled = !hayOpciones || respuestaRevelada;
    btnBiblia.disabled = !hayPregunta;
    if (estudioActual && preguntaActual) {
      const idx = estudioActual.preguntas.findIndex(p => p.n === preguntaActual.n);
      btnAnterior.disabled = idx <= 0;
      btnSiguiente.disabled = idx >= estudioActual.preguntas.length - 1;
    } else {
      btnAnterior.disabled = true;
      btnSiguiente.disabled = true;
    }
  }

  function enviarProyeccion(revelarRespuesta) {
    if (!ws || ws.readyState !== WebSocket.OPEN || !preguntaActual) return;
    ws.send(JSON.stringify({
      type: "project-fe",
      reference: `Estudio ${estudioActual.id} - P${preguntaActual.n}`,
      data: {
        estudioId: estudioActual.id,
        estudioTitulo: estudioActual.titulo,
        estudioSubtitulo: estudioActual.subtitulo,
        preguntaN: preguntaActual.n,
        totalPreguntas: estudioActual.preguntas.length,
        pregunta: preguntaActual.pregunta,
        referencia: preguntaActual.referencia,
        opciones: preguntaActual.opciones || [],
        correcta: revelarRespuesta ? preguntaActual.correcta : -1,
        respuestaRevelada: revelarRespuesta
      }
    }));
  }

  btnMostrar.addEventListener("click", () => enviarProyeccion(false));
  btnRevelar.addEventListener("click", () => {
    respuestaRevelada = true;
    renderPreview();
    actualizarBotones();
    enviarProyeccion(true);
  });
  btnBiblia.addEventListener("click", () => {
    if (!preguntaActual || !preguntaActual.referencia) return;
    const url = new URL("biblia.html", location.href);
    url.searchParams.set("ref", preguntaActual.referencia);
    url.searchParams.set("version", "Dios Habla Hoy");
    window.open(url.toString(), "_blank");
  });
  btnAnterior.addEventListener("click", () => {
    if (!estudioActual || !preguntaActual) return;
    const idx = estudioActual.preguntas.findIndex(p => p.n === preguntaActual.n);
    if (idx > 0) seleccionarPregunta(estudioActual.preguntas[idx - 1]);
  });
  btnSiguiente.addEventListener("click", () => {
    if (!estudioActual || !preguntaActual) return;
    const idx = estudioActual.preguntas.findIndex(p => p.n === preguntaActual.n);
    if (idx < estudioActual.preguntas.length - 1) seleccionarPregunta(estudioActual.preguntas[idx + 1]);
  });

  document.addEventListener("keydown", (e) => {
    if (e.target.tagName === "SELECT" || e.target.tagName === "INPUT") return;
    if (e.key === "ArrowRight") btnSiguiente.click();
    if (e.key === "ArrowLeft") btnAnterior.click();
    if (e.key === " ") { e.preventDefault(); btnMostrar.click(); }
    if (e.key === "r" || e.key === "R") btnRevelar.click();
  });

  function escapeHtml(t) {
    return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  estudioSelect.addEventListener("change", () => cargarEstudio(estudioSelect.value));
  cargarEstudios();
  connectWebSocket();
</script>
</body>
</html>
